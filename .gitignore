# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem
*.cert
*.key

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files — keep examples commit-able
.env
.env.*
!.env.example
!.env.*.example

# vercel / deploy
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite / local data (self-hosted runtime state)
/data/*.db
/data/*.db-*
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# local scratch / experiments
/scratch/

# caches & tooling
.turbo
.eslintcache
.stylelintcache
*.cache
.cache/

# editors / IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo
*~

# OS
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini
